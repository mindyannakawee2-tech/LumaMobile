
# ============================================================
# LumaMobile Raspberry Pi 4 + XPT2046
# ============================================================

LUMA_TARGET="rpi4-xpt2046"

# ------------------------------------------------------------
# Display
#
# Most generic 3.5" XPT2046 Raspberry Pi displays use:
#
#     LCD controller : ILI9486
#     resolution     : 480 x 320
#     portrait       : 320 x 480
#
# ------------------------------------------------------------

LUMA_LCD_DRIVER="ili9486"

LUMA_LCD_ROTATE="90"

LUMA_LCD_SPEED="32000000"

LUMA_LCD_RESET="25"

LUMA_LCD_DC="24"

LUMA_LCD_LED="18"


# ------------------------------------------------------------
# XPT2046 / ADS7846 touch
#
# Common wiring:
#
#     Touch CS  = SPI CE1
#     PENIRQ    = GPIO17
#
# ------------------------------------------------------------

LUMA_TOUCH_CS="1"

LUMA_TOUCH_IRQ="17"

LUMA_TOUCH_SPEED="2000000"

LUMA_TOUCH_XOHMS="100"


# Temporary UI scaling for the tiny 320x480 display.
#
# Current LumaShell was developed around ~430x932.
# Later we'll make LumaShell properly responsive.
#
LUMA_UI_SCALE="0.50"

